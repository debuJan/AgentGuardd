# Copy to .env and fill in real values. Never commit .env.
# Used by `docker compose up` (compose reads .env automatically) and by local runs.

# Postgres password for the docker-compose postgres service (required).
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# API database URL. When running via docker compose you can leave this unset:
# compose defaults to postgresql+psycopg://postgres:${POSTGRES_PASSWORD}@postgres:5432/agentguard
# Local dev (no compose): postgresql+psycopg://postgres:<password>@localhost:5433/agentguard
# DATABASE_URL=

# Optional: LLM provider key for live-agent runs.
GROQ_API_KEY=

# Optional: comma-separated env-var names the server permits in
# AgentConfig.auth_header_env for external-agent bearer tokens.
# Empty by default (feature is opt-in, operator-controlled).
AGENTGUARD_ALLOWED_AUTH_ENV=

# Optional: set to 1 to allow external-agent endpoints on private/loopback
# addresses (local development only — never in production).
AGENTGUARD_ALLOW_PRIVATE_ENDPOINTS=

# Set to "true" to use Postgres instead of the in-memory report store.
USE_POSTGRES=false

# REQUIRED in production: API key clients must send as the X-API-Key header
# on every route except /health. Leave empty ONLY for local development.
AGENTGUARD_API_KEY=

# Comma-separated CORS origins for production, e.g.
# AGENTGUARD_CORS_ORIGINS=https://app.example.com
# Defaults to http://localhost:3000 and http://127.0.0.1:3000.
AGENTGUARD_CORS_ORIGINS=

# --- Production hardening ---
# Rate limiting: "<requests>/<second|minute|hour>". /health and the API
# docs are always exempt. With multiple uvicorn workers the effective
# limit is workers x this value (each worker counts independently).
AGENTGUARD_RATE_LIMIT=200/minute
# Set to "false" to disable rate limiting (not recommended in production).
AGENTGUARD_RATE_LIMIT_ENABLED=true

# Uvicorn worker count used by the Docker entrypoint. POST /runs is
# synchronous, so more workers = more concurrent evaluations.
UVICORN_WORKERS=2

# Production overlay (docker-compose.prod.yml): your public domain.
# Caddy obtains and renews the Let's Encrypt certificate automatically —
# point DNS at the host before starting.
DOMAIN=
